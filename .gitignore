# Data - never commit raw/interim data or database files. SynPUF is publicly
# available but its size makes it impossible to commit. data/samples/ is the
# deliberate exception (1k-person CI fixture) — it works because we exclude
# specific subdirectories/patterns here rather than the whole data/ tree,
# which would make it impossible for git to "see" samples/ at all.
data/raw/
data/interim/
*.duckdb
*.duckdb.wal
*.zip

# Secrets
.env
.env.*
*.pem
profiles.yml
#Possible dbt profiles for the snowflake work in the future

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# dbt / dagster / mlflow
transform/target
transform/dbt_packages
transform/logs
mlruns/
mlartifacts/
.dagster/

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/
*.egg-info/
